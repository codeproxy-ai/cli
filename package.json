{
  "name": "@codeproxy/cli",
  "version": "0.2.1",
  "description": "Local proxy server that converts any Chat Completions / Anthropic Messages API into OpenAI Responses API so Codex and Claude Code can use any LLM.",
  "keywords": [
    "openai",
    "responses-api",
    "anthropic",
    "claude",
    "deepseek",
    "proxy",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/server/cli.ts",
    "dev:openai": "tsx src/server/cli.ts --upstream-format openai-chat --base-url https://api.openai.com/v1 --port 8787",
    "dev:config": "tsx src/server/cli.ts --config config.json",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@ai0x0/utils": "^0.0.31",
    "@eslint/js": "^9.39.4",
    "@rollup/rollup-darwin-arm64": "^4.60.3",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "rollup": "^3.30.0",
    "tsup": "^8.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^2.1.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "codeproxy": "dist/cli.js"
  },
  "dependencies": {
    "@codeproxy/core": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codeproxy-ai/cli.git"
  }
}
